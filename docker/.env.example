# ── Database (connect to host's existing MySQL — NOT a new container) ────
# On Linux Docker, host.docker.internal works thanks to extra_hosts in compose.
# If your MySQL listens on a different host, set DB_HOST accordingly.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-root-password-here
DB_NAME=cairn

# ── App secrets ──────────────────────────────────────────────────────────
JWT_SECRET=change-this-jwt-secret-min-32-chars-long-please
JWT_EXPIRES_IN=7d
CAIRN_TELEMETRY_API_KEY=change-this-telemetry-key-shared-with-app

# ── CORS (comma-separated; iPhone doesn't send Origin so this only affects web) ─
CORS_ORIGINS=http://localhost:8082,http://localhost:19006

# ── Optional: Google Sign-In ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Email (Gmail App Password) ───────────────────────────────────────────
EMAIL_FROM=your@gmail.com
EMAIL_PASS=your_16char_app_password

# ── Reverse proxy ────────────────────────────────────────────────────────
# 1 = trust 1 hop (nginx/caddy in front). Set false to use direct connection IP.
TRUST_PROXY=1

# ── Controlled Public Cairn pilot (fail-closed) ─────────────────────────
# Production activation requires all three values. Keep sensitive-zone
# coordinates only in the server's private .env, never in Git or receipts.
PUBLIC_CAIRN_PILOT_ENABLED=0
PUBLIC_CAIRN_PILOT_USER_IDS=
PUBLIC_CAIRN_SENSITIVE_ZONES_JSON=
# Deploy-only short-lived JWTs used for authenticated post-restart checks.
# The user token must belong to an allowlisted actor; the operator token must
# belong to the disposable second actor with public_cairn_operator=1.
PUBLIC_CAIRN_SMOKE_USER_TOKEN=
PUBLIC_CAIRN_SMOKE_OPERATOR_TOKEN=
