+CREATE TABLE user_push_prefs (user_id BIGINT UNSIGNED PRIMARY KEY);
+CREATE TABLE data_exports (id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY, user_id BIGINT UNSIGNED NULL);
