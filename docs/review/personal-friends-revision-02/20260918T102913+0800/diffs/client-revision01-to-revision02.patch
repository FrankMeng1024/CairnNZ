+    useMemoryStore.getState().recordPoint(-41, 174, 100_000, {
+      source: 'passive_real', horizontalAccuracyM: 9, continuityState: 'accepted',
+    });
+    useMemoryStore.getState().recordPoint(-41, 174, 120_000, {
+      source: 'activity_real',
