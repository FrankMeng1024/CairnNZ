+import type { Feature, MultiPolygon, Polygon } from 'geojson';
+import { storage } from '../../../store/storage';
+
+export interface FogDisplayCacheEntry {
+  version: 1;
+  accountId: string;
+  authority: string;
+  contentSignature: string;
+  pointKeys: string[];
+  evidenceShape: Feature<Polygon | MultiPolygon> | null;
+  fogShape: Feature<Polygon | MultiPolygon>;
+  savedAt: number;
+}
+
+const keyFor = (accountId: string) => `cairn:memory:fog-display:v1:${accountId}`;
+const latest = new Map<string, FogDisplayCacheEntry>();
+const writeTails = new Map<string, Promise<void>>();
+
+export async function readFogDisplayCache(accountId: string): Promise<FogDisplayCacheEntry | null> {
+  const memory = latest.get(accountId);
+  if (memory) return memory;
+  try {
+    const raw = await storage.getItem(keyFor(accountId));
+    const parsed = raw ? JSON.parse(raw) : null;
+    if (parsed?.version !== 1 || parsed.accountId !== accountId
+        || !parsed.fogShape?.geometry || !Array.isArray(parsed.pointKeys)) return null;
+    latest.set(accountId, parsed);
+    return parsed;
+  } catch {
+    return null;
+  }
+}
+
+export async function writeFogDisplayCache(entry: FogDisplayCacheEntry): Promise<void> {
+  latest.set(entry.accountId, entry);
+  const previous = writeTails.get(entry.accountId) ?? Promise.resolve();
+  const run = previous.catch(() => {}).then(async () => {
+    const current = latest.get(entry.accountId);
+    if (current) await storage.setItem(keyFor(entry.accountId), JSON.stringify(current));
+  });
+  writeTails.set(entry.accountId, run);
+  try { await run; } finally {
+    if (writeTails.get(entry.accountId) === run) writeTails.delete(entry.accountId);
+  }
+}
+
+export function resetFogDisplayCacheMemory(): void {
+  latest.clear();
+}
+
+export const fogDisplayCacheKeyForTest = keyFor;
