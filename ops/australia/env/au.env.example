# Copy to /etc/cairn-au/au.env on the Australia host and chmod 600.
# This template contains names and safe defaults only. Never commit real values.

# Immutable source identity. Use a full 40-character commit SHA.
BACKEND_GIT_SHA=0000000000000000000000000000000000000000
BACKEND_GIT_REF=codex/australia-infrastructure-preparation-20261027
CAIRN_REPO_URL=https://github.com/OWNER/PRIVATE_REPOSITORY.git

# Host layout / compose identity.
DEPLOY_ROOT=/srv/cairn-au
COMPOSE_PROJECT_NAME=cairn-au
MYSQL_IMAGE=mysql:8.0.45
BACKEND_BIND_IP=127.0.0.1
BACKEND_PORT=3001
DB_ADMIN_PORT=3307
DB_ADMIN_HOST=127.0.0.1
DB_ADMIN_USER=root

# Public endpoints. Staging and production must never share a writable DB.
API_DOMAIN=api.example.invalid
STAGING_DOMAIN=au-api.example.invalid
LETSENCRYPT_EMAIL=operator@example.invalid
PUBLIC_API_BASE_URL=https://au-api.example.invalid
CORS_ORIGINS=https://app.example.invalid

# Database. Generate independent random values; do not reuse the China host root password.
DB_NAME=cairn
DB_USER=cairn_app
DB_PASSWORD=REPLACE_IN_SECRET_STORE
MYSQL_ROOT_PASSWORD=REPLACE_IN_SECRET_STORE

# Application secrets. Migrate the current production values where continuity is required.
JWT_SECRET=REPLACE_WITH_EXISTING_PRODUCTION_VALUE
NONCE_SECRET=REPLACE_WITH_DISTINCT_RANDOM_VALUE
JWT_EXPIRES_IN=7d
CAIRN_TELEMETRY_API_KEY=REPLACE_WITH_EXISTING_PRODUCTION_VALUE
TRUST_PROXY=1

# Authentication providers.
GOOGLE_CLIENT_ID=
APPLE_BUNDLE_ID=
APPLE_CLIENT_ID=

# Email and push.
RESEND_API_KEY=
EMAIL_FROM=
EXPO_PUSH_ACCESS_TOKEN=
PUSH_TRANSPORT=expo

# Public Cairn remains fail-closed unless an already-approved production policy is copied.
PUBLIC_CAIRN_PILOT_ENABLED=0
PUBLIC_CAIRN_PILOT_USER_IDS=
PUBLIC_CAIRN_SENSITIVE_ZONES_JSON=

# Diagnostics / exports.
DEBUG_SNAPSHOT_ADMIN_USER_IDS=
EXPORT_DIR=/srv/cairn/exports

# Staging must use 1. Production may use 0 only after one and only one scheduler is confirmed.
DISABLE_CRON=1

# Operations.
ADMIN_CIDR=203.0.113.10/32
BACKUP_RETENTION_DAYS=14
BACKUP_REMOTE=
BACKUP_REMOTE_PREFIX=cairn-au
BACKUP_PRUNE_APPROVED=0
MIGRATION_LEDGER_FILE=/srv/cairn-au/state/migrations_applied

# Cutover safety. Leave unset until the Owner gives a separate production-cutover authorization.
PRODUCTION_CUTOVER_AUTHORIZATION=
SOURCE_WRITES_FROZEN=0
AU_WRITES_STARTED=0
