# EAS ignore — keep ONLY what's needed at runtime.
# Everything below is dev/test/build-output, not part of the running app.
#
# ⚠️ CRITICAL: 有 .easignore 时 EAS 忽略 .gitignore, 所以所有 gitignore
# 的东西也必须在这里显式列出 (R106 修 592MB 上传体积 bug).

# Node dependencies (EAS 服务器会自己 npm install, 不需要上传 ~500MB node_modules)
node_modules/

# Native project 目录 (EAS 会跑 expo prebuild 重新生成)
ios/
android/

# Tests (jest)
__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
**/__tests__/
__mocks__/
__fixtures__/

# Dev / review / spike / research (not runtime — R104)
_self_test_out/
_review/
_spike/
.mapbox-test/
research/

# Environment / credentials (safety net — R104)
.env
.env.*
!.env.example
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
web-build/
.metro-health-check*

# AR assets (feature deferred R99, 0 code refs — R104)
assets/ar/

# Dev scripts (icon generation, smoke tests, etc.)
scripts/gen_*.mjs
scripts/generate-icons.js
scripts/v156_patch.md
pw_screenshot.js
pw_shot.js

# QA / UX / arch docs (screenshots, reviews, sprint evidence)
docs/

# Expo web export (52MB — only used for `expo export` web target)
dist/

# Expo dev cache
.expo/
.expo-shared/
expo-env.d.ts

# HTML prototypes
*.html

# TypeScript build info
*.tsbuildinfo

# OS junk
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Coverage / logs
coverage/
*.log
npm-debug.log*

# Source maps not needed in build (Expo regenerates)
*.map

# Unity framework binary
unity/builds/
