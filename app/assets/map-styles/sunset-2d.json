{
  "version": 8,
  "name": "Cairn Golden Hour 2D",
  "sources": {
    "streets": {
      "url": "mapbox://mapbox.mapbox-streets-v8",
      "type": "vector"
    },
    "terrain": {
      "url": "mapbox://mapbox.mapbox-terrain-v2",
      "type": "vector"
    }
  },
  "glyphs": "mapbox://fonts/mapbox/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#D8CDBF"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "terrain",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "wood", "#879878",
          "scrub", "#9AA58A",
          "grass", "#ADB396",
          "crop", "#C6B89A",
          "snow", "#F4EBDD",
          "#A6AA91"
        ],
        "fill-opacity": 0.85
      }
    },
    {
      "id": "national-park",
      "type": "fill",
      "source": "streets",
      "source-layer": "landuse_overlay",
      "filter": ["==", ["get", "class"], "national_park"],
      "paint": {
        "fill-color": "#7F9272",
        "fill-opacity": 0.46
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "streets",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "park", "#9CAA8D",
          "cemetery", "#A4AD98",
          "hospital", "#D0B9AD",
          "school", "#D2C3AE",
          "residential", "#D4C8BC",
          "#CFC3B6"
        ],
        "fill-opacity": 0.6
      }
    },
    {
      "id": "hillshade",
      "type": "fill",
      "source": "terrain",
      "source-layer": "hillshade",
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "shadow", "#8E8177",
          "highlight", "#F0D9B8",
          "#C8BCAF"
        ],
        "fill-opacity": 0.18
      }
    },
    {
      "id": "contour-line",
      "type": "line",
      "source": "terrain",
      "source-layer": "contour",
      "minzoom": 11,
      "paint": {
        "line-color": "#A67F61",
        "line-opacity": 0.30,
        "line-width": 0.6
      }
    },
    {
      "id": "contour-line-major",
      "type": "line",
      "source": "terrain",
      "source-layer": "contour",
      "minzoom": 11,
      "filter": ["==", ["to-string", ["get", "index"]], "5"],
      "paint": {
        "line-color": "#9B6F51",
        "line-opacity": 0.48,
        "line-width": 1.0
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "streets",
      "source-layer": "water",
      "paint": {
        "fill-color": "#7F9DA5",
        "fill-opacity": 0.96
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "streets",
      "source-layer": "waterway",
      "minzoom": 10,
      "paint": {
        "line-color": "#6F9099",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 16, 2]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "streets",
      "source-layer": "road",
      "minzoom": 12,
      "filter": [
        "match",
        ["get", "class"],
        ["street", "street_limited", "service", "track", "path", "pedestrian"],
        true, false
      ],
      "paint": {
        "line-color": "#E3D6C6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.5, 18, 3],
        "line-opacity": 0.75
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "streets",
      "source-layer": "road",
      "minzoom": 8,
      "filter": [
        "match",
        ["get", "class"],
        ["primary", "secondary", "tertiary"],
        true, false
      ],
      "paint": {
        "line-color": "#F4EBDD",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.6, 16, 4],
        "line-opacity": 0.9
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "streets",
      "source-layer": "road",
      "minzoom": 6,
      "filter": ["==", ["get", "class"], "motorway"],
      "paint": {
        "line-color": "#DDB478",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.8, 16, 5],
        "line-opacity": 0.95
      }
    },
    {
      "id": "admin-boundary",
      "type": "line",
      "source": "streets",
      "source-layer": "admin",
      "filter": [
        "all",
        ["<=", ["get", "admin_level"], 2],
        ["!=", ["get", "maritime"], "true"]
      ],
      "paint": {
        "line-color": "#756C65",
        "line-width": ["match", ["get", "admin_level"], 1, 1.4, 2, 0.9, 0.9],
        "line-dasharray": [2, 2],
        "line-opacity": 0.85
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "streets",
      "source-layer": "road",
      "minzoom": 13,
      "filter": [
        "match",
        ["get", "class"],
        ["motorway", "primary", "secondary", "tertiary", "street"],
        true, false
      ],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Open Sans Regular", "Arial Unicode MS Regular"],
        "text-size": 11,
        "symbol-placement": "line"
      },
      "paint": {
        "text-color": "#43534D",
        "text-halo-color": "#F6EFE5",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-label-locality",
      "type": "symbol",
      "source": "streets",
      "source-layer": "place_label",
      "minzoom": 4,
      "maxzoom": 16,
      "filter": [
        "match",
        ["get", "type"],
        ["settlement", "settlement_subdivision"],
        true, false
      ],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Open Sans Regular", "Arial Unicode MS Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 12, 14],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#273A34",
        "text-halo-color": "#F6EFE5",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "natural-label",
      "type": "symbol",
      "source": "streets",
      "source-layer": "natural_label",
      "minzoom": 6,
      "filter": ["==", ["get", "class"], "landform"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Open Sans Italic", "Arial Unicode MS Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 10, 14, 13],
        "text-max-width": 7
      },
      "paint": {
        "text-color": "#6B594B",
        "text-halo-color": "#F2E7D9",
        "text-halo-width": 1.1
      }
    },
    {
      "id": "water-label",
      "type": "symbol",
      "source": "streets",
      "source-layer": "natural_label",
      "minzoom": 8,
      "filter": ["==", ["get", "class"], "water"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Open Sans Italic", "Arial Unicode MS Regular"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#315F70",
        "text-halo-color": "#D8E3E4",
        "text-halo-width": 1.1
      }
    }
  ]
}
