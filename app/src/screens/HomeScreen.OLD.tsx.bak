const styles = StyleSheet.create({
  // R114/O26 v5 two-zone layout:
  //   heroZone  → top ~55% of screen, mountain photo + light UI
  //   creamPanel → bottom ~45%, warm off-white with rounded top edge
  //                that overlaps the photo (paper-lifted-off-landscape)
  safe: { flex: 1, backgroundColor: '#000' },

  heroZone: {
    ...StyleSheet.absoluteFillObject,
  },
  heroFullBg: {
    ...StyleSheet.absoluteFillObject,
    width: '100%',
    height: '100%',
  },
  heroScrim: {
    // Removed the darkening overlay entirely. Asset is already brighter
    // than the concept moodboard (68% vs 47% luminance at top band).
    // Text still has textShadow so contrast is preserved.
    ...StyleSheet.absoluteFillObject,
    backgroundColor: 'transparent',
  },
  // heroSpacer takes up the remaining vertical space between hero band and
  // cream panel. FAB sits at its bottom-right so it always tucks just above
  // the paper edge, regardless of screen height.
