});

const lastHikeStyles = StyleSheet.create({
  // Single card shell for both data and empty state. Same paint, same
  // border, same padding — only the text inside changes. Keeps visual
  // weight identical between "fresh install" and "1000 hikes logged".
  card: {
    flexDirection: 'row',
    alignItems: 'stretch',
    gap: Spacing.sm,
    // Concept-sampled median from 12 grid points: #ccc4b2 (Last Hike card
    // interior has slight top-left brighter gradient but the tone the eye
    // reads is the mid-tone).
    backgroundColor: '#ccc4b2',
    borderRadius: 12,
    paddingHorizontal: Spacing.md,
    paddingVertical: Spacing.md,
    borderWidth: 1,
    borderColor: 'rgba(0,0,0,0.06)',
    // Concept-scaled: card height ~180 (concept 180 * 1.07 y-scale = 192).
    minHeight: 180,
  },
  textCol: { flex: 1, gap: 2 },
  eyebrow: {
