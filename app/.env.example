# Cairn app — environment variables example
#
# Copy to .env (already gitignored) and fill in real values.
# Vars must be EXPO_PUBLIC_* to be exposed in the app bundle.

# Mapbox token — get from https://account.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_TOKEN=

# Google OAuth client ID (optional)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Telemetry backend default — DebugScreen lets users override at runtime,
# but this is the fallback if they leave Backend URL empty.
# Example: http://192.168.1.100:3001  (dev) or https://cairn.example.com (prod)
EXPO_PUBLIC_BACKEND_URL=
