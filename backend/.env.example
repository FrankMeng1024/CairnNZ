PORT=3001
NODE_ENV=development
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=cairn
JWT_SECRET=your-jwt-secret-min-64-chars
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:8082,http://localhost:19006
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Mapbox server-side token for MVT junction extraction (v229 EditEnvelope).
# Use a Mapbox public token (pk.*) with URL-restriction enabled.
# Required for /api/routes/:id/edit-envelope to function. Without it,
# envelope builds silently fail and edits fall back to legacy on-device
# extractor (which OOM'd 4 times — do NOT skip this).
MAPBOX_SERVER_TOKEN=
