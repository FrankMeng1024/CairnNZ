PORT=3001
NODE_ENV=development
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=cairn
JWT_SECRET=your-jwt-secret-min-64-chars
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:8082,http://localhost:19006
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id

# Trust proxy layer count. Default 1 (behind single nginx/ELB). Set 'false' in
# local dev to see the real client IP for rate-limit debugging.
TRUST_PROXY=1

# Disable background cron jobs when set to '1'. Used in test / migration
# environments to avoid schedulers firing before manual data setup completes.
DISABLE_CRON=0

# Email delivery (nodemailer). EMAIL_FROM is the sender address shown to
# recipients; EMAIL_PASS is the SMTP app-password.
EMAIL_FROM=
EMAIL_PASS=

# Cookie / signed-nonce HMAC secret. MUST differ from JWT_SECRET.
# Minimum 32 chars. Rotate on suspected leak.
NONCE_SECRET=

# Device-level shared secret for /api/telemetry uploads. Multiple devices
# share one key. Rotate on suspected leak.
CAIRN_TELEMETRY_API_KEY=
